# Harness-owned memory DB (Supabase or Neon - separate from source DB)
# Enable pgvector on this instance before running migrations
HARNESS_DB_URL=postgresql://user:password@host:5432/harness_db

# ConceptDash source DB - READ-ONLY role, no INSERT/UPDATE/DELETE/DDL grants
# CRM DB (schema: public, schema_3)
CRM_SOURCE_DB_URL=postgresql://readonly_user:password@host:5432/crm_db
# HRM DB (schema: public, schema_118, schema_3)
HRM_SOURCE_DB_URL=postgresql://readonly_user:password@host:5432/hrm_db

# LLM Keys
# Primary: Google AI Studio (Gemini Flash - no card, large context, high quota)
LLM_PRIMARY_KEY=your_google_ai_studio_key_here
# Fallback: Groq (OpenAI-compatible, easy adapter swap)
LLM_FALLBACK_KEY=your_groq_api_key_here

# Server
PORT=3000
NODE_ENV=development

# Terminal REPL mode — set to 'true' to converse in terminal instead of HTTP server
REPL=false

db-passcode : HW8j$VWCeE?8vXg
